{
  "model": "sonnet",
  "promptCacheTtl": "1h",
  "crossSessionInbound": "hold",
  "autoContinueAtUsageLimit": false,
  "env": {
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/hooks/statusline_costo.sh",
    "padding": 1
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/arranque_estado.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/contador_turnos.sh"
          }
        ]
      }
    ]
  }
}
